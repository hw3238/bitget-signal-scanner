{
  "name": "bitget-signal-scanner",
  "private": true,
  "version": "1.5.7",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc -b && vite build",
    "icons": "node scripts/fetch-coin-icons.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "check:stops": "esbuild scripts/stop-width-check.ts --bundle --platform=node --format=esm --outfile=.tmp/stop-width-check.mjs --log-level=error && node .tmp/stop-width-check.mjs",
    "check:calc": "esbuild scripts/calc-check.ts --bundle --platform=node --format=esm --outfile=.tmp/calc-check.mjs --log-level=error && node .tmp/calc-check.mjs",
    "check:cockpit": "esbuild scripts/cockpit-check.ts --bundle --platform=node --format=esm --outfile=.tmp/cockpit-check.mjs --log-level=error && node .tmp/cockpit-check.mjs",
    "check:journal": "esbuild scripts/journal-check.ts --bundle --platform=node --format=esm --outfile=.tmp/journal-check.mjs --log-level=error && node .tmp/journal-check.mjs",
    "check:adoption": "esbuild scripts/adoption-check.ts --bundle --platform=node --format=esm --outfile=.tmp/adoption-check.mjs --log-level=error && node .tmp/adoption-check.mjs",
    "check:surge": "esbuild scripts/surge-check.ts --bundle --platform=node --format=esm --outfile=.tmp/surge-check.mjs --log-level=error && node .tmp/surge-check.mjs",
    "check:journal-e2e": "node scripts/journal-e2e.mjs",
    "check:features": "node scripts/features-check.mjs",
    "check:surge-e2e": "node scripts/surge-e2e.mjs",
    "check:autotrade": "esbuild scripts/autotrade-check.ts --bundle --platform=node --format=esm --outfile=.tmp/autotrade-check.mjs --log-level=error && node .tmp/autotrade-check.mjs",
    "check:settings": "esbuild scripts/settings-check.ts --bundle --platform=node --format=esm --outfile=.tmp/settings-check.mjs --log-level=error && node .tmp/settings-check.mjs",
    "check:autotrade-e2e": "node scripts/autotrade-e2e.mjs",
    "settings-e2e": "node scripts/settings-e2e.mjs",
    "bench:strategies": "esbuild scripts/strategy-tournament.ts --bundle --platform=node --format=esm --outfile=.tmp/strategy-tournament.mjs --log-level=error && node .tmp/strategy-tournament.mjs",
    "check:native": "bash scripts/native-check.sh"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/cli": "^6.2.3",
    "@capacitor/core": "^6.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "1.49.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
