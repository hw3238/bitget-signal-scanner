<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme: dark neon shell -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/neon_bg</item>
        <item name="android:statusBarColor">@color/neon_bg</item>
        <item name="android:navigationBarColor">@color/neon_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">#E6F1FF</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@color/neon_bg</item>
        <item name="android:windowBackground">@color/neon_bg</item>
        <item name="android:statusBarColor">@color/neon_bg</item>
        <item name="android:navigationBarColor">@color/neon_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/neon_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">@color/neon_bg</item>
        <item name="android:navigationBarColor">@color/neon_bg</item>
    </style>
</resources>
